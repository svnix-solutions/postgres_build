# Superuser password. Required.
POSTGRES_PASSWORD=changeme

POSTGRES_USER=postgres
POSTGRES_DB=postgres

# pgAdmin web login.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changeme

# Host path the backups are written to. Required -- there is no default,
# because a wrong one silently fills the node's local disk.
# Mount your NAS/backup volume here first.
PGBACKUP_PATH=/mnt/pgbackup

# Address the ports bind to. Defaults to 127.0.0.1 (loopback only).
# Set to a LAN address to reach the services from other hosts, e.g. 10.0.0.5.
# Do not use 0.0.0.0 unless you mean to expose a database to every interface.
POSTGRES_BIND=127.0.0.1
PGADMIN_BIND=127.0.0.1

# Days of dumps to keep.
BACKUP_RETENTION_DAYS=14

# Shared docker network name for the two services.
DB_NETWORK=db

# Server image. Defaults to stock postgres:17-alpine. Set this to a PostGIS
# build if you need spatial types -- postgis/postgis:17-3.5-alpine is the same
# postgres:17-alpine with PostGIS added, so it swaps in under an existing
# PGDATA without a reindex.
#
# Do NOT switch between alpine and debian variants on an existing cluster:
# collation ordering comes from libc, and changing it can silently corrupt
# text btree indexes.
POSTGRES_IMAGE=postgres:17-alpine
